{
  "name": "backend",
  "type": "module",
  "private": true,
  "scripts": {
    "watch": "tsx watch src/server.ts",
    "build": "tsc --outDir dist --noEmit false",
    "start": "tsx src/server.ts",
    "start:inngest": "npx inngest-cli@latest dev",
    "start:server": "nodemon --exec tsx src/server.ts",
    "dev": "concurrently -c \"blue,cyan\" -n \"SERVER,INNGEST\" \"npm run start:server\" \"npm run start:inngest\""
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.5.3",
    "better-auth": "^1.5.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "inngest": "^3.52.6",
    "mongodb": "^7.1.0",
    "mongoose": "^9.2.4",
    "morgan": "^1.10.1",
    "socket.io": "^4.8.3",
    "uploadthing": "^7.7.4",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}